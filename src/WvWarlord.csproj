<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <RunPostBuildEvent>OnBuildSuccess</RunPostBuildEvent>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <IsPublishable>False</IsPublishable>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <IsPublishable>False</IsPublishable>
  </PropertyGroup>

	<ItemGroup>
		<Compile Remove="Backups\**" />
		<EmbeddedResource Remove="Backups\**" />
		<None Remove="Backups\**" />
	</ItemGroup>

	<ItemGroup>
	  <Compile Remove="WvwCardClaimed.cs" />
	  <Compile Remove="WvwCardPro.cs" />
	  <Compile Remove="WvwCardStandard.cs" />
	  <Compile Remove="WvwCardTiny.cs" />
	</ItemGroup>

	<ItemGroup>
    <PackageReference Include="BlishHUD" Version="1.3.0" ExcludeAssets="runtime;contentFiles;analyzers" />
    <PackageReference Include="Gw2Sharp" Version="2.0.0-preview.1" />
    <PackageReference Include="System.ComponentModel.Composition" Version="10.0.11" />
    <PackageReference Include="System.Composition" Version="10.0.11" />
    <PackageReference Include="System.Text.Encodings.Web" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <None Update="ref\wvw_icon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
	
	<ItemGroup>
		<Reference Include="System.Net.Http">
			<HintPath>$(MSBuildToolsPath)\System.Net.Http.dll</HintPath>
			<Private>True</Private>
		</Reference>
	</ItemGroup>
	
	<Target Name="PostBuild" AfterTargets="PostBuildEvent">
	  <Exec Command="@echo off&#xA;set &quot;cur_hr=%25time:~0,2%25&quot;&#xA;if &quot;%25cur_hr:~0,1%25&quot;==&quot; &quot; set &quot;cur_hr=0%25cur_hr:~1,1%25&quot;&#xA;set &quot;SRC=%25cd%25&quot;&#xA;&#xA;:: Define the target destination path&#xA;set &quot;DEST=%25SRC%25\Backups\Backup_%25date:~-4,4%25%25date:~-10,2%25%25date:~-7,2%25_%25cur_hr%25%25time:~3,2%25&quot;&#xA;&#xA;:: Run robocopy with /S (include subfolders) and /XD (exclude specific folders)&#xA;robocopy &quot;%25SRC%25&quot; &quot;%25DEST%25&quot; *.cs /S /XD Backups bin obj ref Properties .vs&#xA;&#xD;&#xA;&#xA;if %25ERRORLEVEL%25 LEQ 3 exit /b 0&#xA;" />
	</Target>
	
	<ItemGroup>
		<Reference Include="Microsoft.CSharp" />
	</ItemGroup>

</Project>




